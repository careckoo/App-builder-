      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التالي"
          }
        }
      }
    },
    "No spending yet today": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مصاريف اليوم بعد"
          }
        }
      }
    },
    "Not a transaction, skipped": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليست عملية مالية، تم التجاهل"
          }
        }
      }
    },
    "Note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملاحظة"
