        }
      }
    },
    "Choose Run Immediately, then tap Next.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر «تشغيل فوراً» ثم اضغط «التالي»."
          }
        }
      }
    },
