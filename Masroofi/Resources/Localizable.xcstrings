      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط رسائل بنكك — مرة وحدة بس"
          }
        }
      }
    },
    "Date": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ"
          }
        }
      }
