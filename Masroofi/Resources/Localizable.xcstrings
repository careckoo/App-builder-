    "Days to payday": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيام حتى الراتب"
          }
        }
      }
    },
    "Delete transaction": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف العملية"
          }
