    "Adds an Apple Pay purchase from the Wallet Transaction automation to Masroofi.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف الشراء بـ Apple Pay من أتمتة «المعاملة» في المحفظة إلى مصروفي."
          }
        }
      }
    },
    "Already logged": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسجّلة من قبل"
          }
        }
      }
    },
    "Already logged. Added the bank's details to it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسجّلة من قبل. أضفنا لها تفاصيل البنك."
          }
        }
      }
    },
    "Always use this for %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم هذه الفئة دائماً لـ %@"
