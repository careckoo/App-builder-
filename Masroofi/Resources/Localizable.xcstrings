      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدير CSV"
          }
        }
      }
    },
    "Finish the Shortcuts setup and your next card payment will show up here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل إعداد الاختصارات وأول عملية بالبطاقة بتظهر هنا."
          }
        }
      }
    },
    "Fixed bills": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفواتير الثابتة"
          }
        }
      }
    },
    "Go easy for the rest of today": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خفّف باقي اليوم"
          }
        }
      }
    },
    "How much you can spend today and still reach payday.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم تقدر تصرف اليوم وتوصل للراتب براحة."
          }
        }
      }
    },
    "I'll finish this later": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بكمّل بعدين"
          }
        }
      }
    },
    "If a bank's sender name is different on your phone, use the name exactly as it appears in Messages.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان اسم المرسل مختلف في جوالك، اكتبه بالضبط كما يظهر في الرسائل."
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللغة"
          }
        }
      }
    },
    "Left until payday": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المتبقي حتى الراتب"
          }
        }
      }
    },
    "Let's start": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلا نبدأ"
          }
        }
      }
    },
    "Log bank message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل رسالة البنك"
          }
        }
      }
    },
    "Masroofi": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصروفي"
          }
        }
      }
    },
    "Masroofi reads those messages and keeps your budget for you. No typing numbers, no bank passwords, and nothing leaves your iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصروفي يقرأ هذه الرسائل ويرتّب ميزانيتك عنك. بدون إدخال أرقام، بدون كلمات مرور البنك، وكل شيء يبقى على جوالك."
          }
        }
      }
    },
    "Merchant": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المتجر"
          }
        }
      }
    },
    "Message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرسالة"
          }
        }
      }
    },
    "Monthly limit (AED)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الشهري (درهم)"
          }
        }
      }
    },
    "Monthly salary (AED)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الراتب الشهري (درهم)"
          }
        }
      }
    },
    "Name, e.g. Rent": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاسم، مثل: الإيجار"
          }
