{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@%@. Left today: AED %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@%3$@. الباقي لليوم: %4$@ درهم"
          }
        }
      }
    },
    "%lld days to payday": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld يوم حتى الراتب"
