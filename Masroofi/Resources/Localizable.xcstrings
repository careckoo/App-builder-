    "Bank statement": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كشف حساب البنك"
          }
        }
      }
    },
    "Banks are moving alerts into their own apps, and iPhone doesn't let other apps read those. Set up one or more of these instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البنوك قاعدة تنقل التنبيهات لتطبيقاتها، والآيفون ما يسمح لتطبيق ثاني يقراها. فعّل وحدة أو أكثر من هذي الطرق بدالها."
          }
        }
      }
    },
    "Budgets": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميزانيات"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء"
          }
        }
      }
    },
    "Card": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البطاقة"
          }
        }
      }
    },
    "Card bill payment of %@ %@ logged. It doesn't change today's amount.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل سداد البطاقة بمبلغ %1$@ %2$@. ما يغيّر مبلغ اليوم."
          }
        }
      }
    },
    "Catches online and card-swipe payments that don't go through Apple Pay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلقط الدفعات أونلاين وبالبطاقة اللي ما تمر عبر Apple Pay."
          }
        }
      }
    },
    "Category": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفئة"
          }
        }
      }
    },
    "Check it works": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد إنه يشتغل"
          }
        }
      }
    },
    "Choose your cards (all of them is fine), choose Run Immediately, then tap Next.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بطاقاتك (كلها عادي)، واختر «تشغيل فوراً»، ثم اضغط «التالي»."
          }
        }
      }
    },
    "Date": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ"
          }
        }
      }
    },
    "Days to payday": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيام حتى الراتب"
          }
        }
      }
    },
    "Delete transaction": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف العملية"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم"
          }
        }
      }
