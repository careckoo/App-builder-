    "Salary": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الراتب"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفظ"
          }
        }
      }
    },
    "Save each month (AED)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الادخار الشهري (درهم)"
          }
        }
      }
    },
    "Savings goals": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أهداف الادخار"
          }
        }
      }
    },
    "School fees": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسوم المدرسة"
          }
        }
      }
    },
    "Search for Khurda and choose “Log Apple Pay purchase”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن «خردة» واختر «تسجيل شراء Apple Pay»."
          }
        }
      }
    },
    "Search for Khurda, choose “Log bank message or email”, then set Message to the email's body, and Sender and Subject to the email's sender and subject.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن «خردة» واختر «تسجيل رسالة أو إيميل البنك»، وخلّ «الرسالة» على نص الإيميل، و«المرسل» و«الموضوع» على مرسل الإيميل وموضوعه."
          }
        }
      }
    },
    "Search for Khurda, choose “Log bank message or email”, then tap Message and pick Shortcut Input → Message.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن «خردة» واختر «تسجيل رسالة أو إيميل البنك»، ثم اضغط «الرسالة» واختر مُدخل الاختصار ← الرسالة."
          }
        }
      }
    },
    "Search merchants or categories": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن متجر أو فئة"
          }
        }
      }
    },
    "Sender": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المرسل"
          }
        }
      }
    },
    "Set Amount, Merchant and Card to the matching Shortcut Input (Amount, Merchant, Card or Pass). Tap Done.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلّ «المبلغ» و«المتجر» و«البطاقة» على ما يقابلها من مُدخل الاختصار (المبلغ، التاجر، البطاقة أو التذكرة). ثم اضغط «تم»."
          }
        }
      }
    },
    "Set aside each month (AED)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم تحجز كل شهر (درهم)"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإعدادات"
          }
        }
      }
    },
    "Share %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السهم %@"
          }
        }
      }
    },
    "Show Khurda the amount and the shop once. Messages like it are read by themselves after that.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ورّ خردة المبلغ والمحل مرة وحدة، وبعدها الرسايل اللي مثلها تنقرا بروحها."
          }
        }
      }
    },
    "Small things that add up": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصاريف صغيرة تتراكم"
          }
        }
      }
    },
    "Something else": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شي ثاني"
          }
        }
      }
    },
    "Spending calendar": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقويم المصاريف"
          }
        }
      }
    },
    "Start again": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من جديد"
          }
        }
      }
    },
    "Starts %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ %@"
          }
        }
      }
    },
    "Stored only on this iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظة على هذا الآيفون فقط."
          }
        }
      }
    },
    "Subject": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموضوع"
          }
        }
      }
    },
    "Take out": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب"
          }
        }
      }
    },
    "Tap a word again to undo. Nothing leaves your iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الكلمة مرة ثانية عشان تلغيها. ولا شي يطلع من جوالك."
          }
        }
      }
    },
    "Target (AED)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الهدف (درهم)"
          }
        }
      }
    },
    "Teach Khurda": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علّم خردة"
          }
        }
      }
    },
    "Teach Khurda this message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علّم خردة هالرسالة"
          }
        }
      }
    },
    "That doesn't look like an amount. Tap the number with the money in it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ما يبين إنه مبلغ. اضغط على الرقم اللي فيه الفلوس."
          }
        }
      }
    },
    "The group is holding %@ of yours.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لك عند الجمعية %@."
          }
        }
      }
    },
    "The monthly amount comes off your salary on payday, before today's amount is worked out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المبلغ الشهري ينحجز من راتبك يوم الراتب، قبل ما ينحسب مصروف اليوم."
          }
        }
      }
    },
    "The share is set aside from your daily amount each month, like a bill. Your pot won't be counted as spending money.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السهم ينحجز من مصروفك كل شهر مثل الفاتورة. ولما تستلم الجمعية، ما تدخل في مصروف اليوم."
          }
        }
      }
    },
    "There's no shop name": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما فيها اسم محل"
          }
        }
      }
    },
    "This cycle's share is paid": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دفعت سهم هالدورة"
          }
        }
      }
    },
    "This doesn't look like a transaction.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هالرسالة ما تبين إنها عملية مالية."
          }
        }
      }
    },
    "This is a fixed bill (rent, school, installment)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه فاتورة ثابتة (إيجار، مدرسة، قسط)"
          }
        }
      }
    },
    "This is the only time you'll type a number. When your salary SMS arrives, Khurda uses the real amount.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المرة الوحيدة اللي تكتب فيها رقم. لما توصل رسالة الراتب، نستخدم المبلغ الفعلي."
          }
        }
      }
    },
    "This pay cycle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورة الراتب الحالية"
          }
        }
      }
    },
    "Ticked by itself when a bank transfer of %@ arrives. Until then it's set aside from your daily amount.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينعلّم بروحه لما يوصل تحويل بنكي بقيمة %@. لين ذاك الوقت يبقى محجوز من مصروفك."
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليوم"
          }
        }
      }
    },
    "Today: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليوم: %@"
          }
        }
      }
    },
    "Tracking": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التتبّع"
          }
        }
      }
    },
    "Transaction": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية"
          }
        }
      }
    },
    "Transfer out": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحويل لبرّا"
          }
        }
      }
    },
    "Travel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سفر"
          }
        }
      }
    },
    "Umrah": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمرة"
          }
        }
      }
    },
    "Waiting for your next card payment, or paste an old bank SMS from Today › Paste.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ننتظر عمليتك القادمة بالبطاقة، أو الصق رسالة قديمة من «اليوم» ← «لصق»."
          }
        }
      }
    },
    "We understood": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فهمنا التالي"
          }
        }
      }
    },
    "We'll treat the %@ that came in on %@ as your pot, so it doesn't count as spending money.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بنعتبر الـ%1$@ اللي وصلت يوم %2$@ هي جمعيتك، فما بتنحسب فلوس للصرف."
          }
        }
      }
    },
    "Wedding": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرس"
          }
        }
      }
    },
    "What is it?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شو نوعها؟"
          }
        }
      }
    },
    "When a bank message isn't understood, you can teach Khurda from Paste or from Activity.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لما رسالة بنك ما تنقرا، تقدر تعلّم خردة من «الصق رسالة» أو من الحركات."
          }
        }
      }
    },
    "When your pot arrives in your account, tick this so it doesn't go into today's amount.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لما توصل جمعيتك حسابك، علّم هني عشان ما تدخل في مصروف اليوم."
          }
        }
      }
    },
    "Where": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المكان"
          }
        }
      }
    },
    "Where (optional)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وين؟ (اختياري)"
          }
        }
      }
    },
    "Where it went": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وين راحت فلوسك"
          }
        }
      }
    },
    "Which banks text you?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي البنوك ترسل لك رسائل؟"
          }
        }
      }
    },
    "Will your salary last?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيكفّيك الراتب؟"
          }
        }
      }
    },
    "Work jameya": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جمعية الدوام"
          }
        }
      }
    },
    "Works with any bank card in Apple Wallet, even if your bank only sends app notifications.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشتغل مع أي بطاقة بنك في Apple Wallet، حتى لو بنكك يرسل تنبيهات التطبيق بس."
          }
        }
      }
    },
    "You can spend AED %lld today, %lld days to payday.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدر تصرف %1$lld درهم اليوم، والأيام الباقية على الراتب: %2$lld."
          }
        }
      }
    },
    "You spend about %@ a day.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصرف تقريباً %@ باليوم."
          }
        }
      }
    },
    "You're doing great": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ممتاز، كمّل كذا"
          }
        }
      }
    },
    "You've had the pot early: %@ still to pay in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استلمت الجمعية بدري: باقي عليك تدفع %@."
          }
        }
      }
    },
    "You've had your turn · %lld shares left": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخذت دورك · باقي عليك %#@n@"
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg أسهم"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg سهم"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "سهم واحد"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg سهم"
                    }
                  },
                  "two": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "سهمين"
                    }
                  },
                  "zero": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Your bank already texts you every purchase": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بنكك يرسل لك رسالة مع كل عملية"
          }
        }
      }
    },
    "Your first transaction arrived": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت أول عملية"
          }
        }
      }
    },
    "Your messages and transactions stay on this iPhone. Khurda has no server and never asks for bank logins.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسائلك وعملياتك تبقى على هذا الآيفون. خردة ما عنده خادم وما يطلب أبداً بيانات دخول البنك."
          }
        }
      }
    },
    "Your month": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شهرك"
          }
        }
      }
    },
    "Your pot": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جمعيتك"
          }
        }
      }
    },
    "Your pot is your own money coming back (or paid in advance), so it doesn't go into today's amount.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جمعيتك هي فلوسك ترجع لك (أو مقدّمة لك)، فما تدخل في مصروف اليوم."
          }
        }
      }
    },
    "Your salary": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راتبك"
          }
        }
      }
    },
    "Your turn": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورك"
          }
        }
      }
    },
