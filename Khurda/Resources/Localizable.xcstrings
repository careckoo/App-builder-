    },
    "Rent, school fees, DEWA or TAQA, Tabby and Tamara installments. They're set aside before your daily amount is worked out, and ticked off when the bank message arrives.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإيجار، رسوم المدارس، فاتورة طاقة أو ديوا، وأقساط تابي وتمارا. نخصمها قبل حساب مبلغك اليومي، وتتعلّم كمدفوعة لما توصل رسالة البنك."
          }
        }
      }
    },
    "Round %lld of %lld. Your turn is round %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشهر %1$lld من %2$lld. دورك الشهر %3$lld."
          }
        }
      }
    },
    "SMS": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسالة نصية"
          }
        }
      }
    },
    "Safe to spend": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المسموح اليوم"
          }
        }
      }
    },
    "Safe to spend today": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدر تصرف اليوم"
          }
        }
