    "It's regular": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثابت كل شهر"
          }
        }
      }
    },
    "Its share stops being set aside. Your transactions stay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما بينحجز سهمها بعد اليوم، وحركاتك تبقى مثل ما هي."
          }
