        }
      }
    },
    "Type": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النوع"
          }
        }
      }
    },
    "Type its password. It stays on your phone and isn't saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب كلمة السر. تبقى في جوالك وما نحفظها."
          }
        }
      }
    },
    "Umrah": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمرة"
          }
        }
      }
    },
    "Undo import": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراجع عن الاستيراد"
          }
        }
      }
    },
    "Untick anything you don't want. Tap the category to change it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شيل الصح عن أي شي ما تبيه. اضغط على الفئة عشان تغيّرها."
          }
        }
      }
    },
    "Up to %@ a month": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لين %@ بالشهر"
          }
        }
      }
    },
    "Use %@ instead": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلّه %@"
          }
        }
      }
    },
    "Use this target": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعتمد هذا الهدف"
          }
        }
      }
    },
    "Used only for typical UAE spending, until Khurda has seen a full month of yours.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نستخدمه بس للمصروف المعتاد في الإمارات، لين يشوف خردة شهر كامل من مصروفك."
          }
        }
      }
    },
    "Usual spending is based on typical UAE spending until Khurda sees a full month of yours. Import a statement to make it yours now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصروفك المعتاد مبني على مصروف معتاد في الإمارات لين يشوف خردة شهر كامل من مصروفك. استورد كشف حساب عشان يصير على مقاسك من الحين."
          }
        }
      }
    },
    "Usual spending is the middle of your last 3 months, big one-offs left out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصروفك المعتاد هو الوسط من آخر 3 شهور، بدون المشتريات الكبيرة."
          }
        }
      }
    },
    "Usual spending mixes your own months so far with typical UAE spending.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصروفك المعتاد يجمع بين شهورك لين الحين ومصروف معتاد في الإمارات."
          }
        }
      }
    },
    "Usually spend": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصروفك المعتاد"
          }
        }
      }
    },
    "Waiting for your next card payment, or paste an old bank SMS from Today › Paste.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ننتظر عمليتك القادمة بالبطاقة، أو الصق رسالة قديمة من «اليوم» ← «لصق»."
          }
        }
      }
    },
    "Ways to save": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طرق توفّر فيها"
          }
        }
      }
    },
    "We couldn't find a table of transactions in this file. Try the Excel or CSV version from your bank.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما لقينا جدول حركات في الملف. جرّب نسخة الإكسل أو CSV من البنك."
          }
        }
      }
    },
    "We couldn't open this file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما قدرنا نفتح الملف."
          }
        }
      }
    },
    "We understood": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فهمنا التالي"
          }
        }
      }
    },
    "We'll treat the %@ that came in on %@ as your pot, so it doesn't count as spending money.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بنعتبر الـ%1$@ اللي وصلت يوم %2$@ هي جمعيتك، فما بتنحسب فلوس للصرف."
          }
        }
      }
    },
    "Wedding": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرس"
          }
        }
      }
    },
    "What is it?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شو نوعها؟"
          }
        }
      }
    },
    "What you usually spend": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصروفك المعتاد"
          }
        }
      }
    },
    "When a bank message isn't understood, you can teach Khurda from Paste or from Activity.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لما رسالة بنك ما تنقرا، تقدر تعلّم خردة من «الصق رسالة» أو من الحركات."
          }
        }
      }
    },
    "When your pot arrives in your account, tick this so it doesn't go into today's amount.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لما توصل جمعيتك حسابك، علّم هني عشان ما تدخل في مصروف اليوم."
          }
        }
      }
    },
    "Where": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المكان"
          }
        }
      }
    },
    "Where (optional)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وين؟ (اختياري)"
          }
        }
      }
    },
    "Where it went": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وين راحت فلوسك"
          }
        }
      }
    },
    "Which banks text you?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي البنوك ترسل لك رسائل؟"
          }
        }
      }
    },
    "Who's at home": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منو في البيت"
          }
        }
      }
    },
    "Will your salary last?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيكفّيك الراتب؟"
          }
        }
      }
    },
    "Work jameya": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جمعية الدوام"
          }
        }
      }
    },
    "Works with any bank card in Apple Wallet, even if your bank only sends app notifications.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشتغل مع أي بطاقة بنك في Apple Wallet، حتى لو بنكك يرسل تنبيهات التطبيق بس."
          }
        }
      }
    },
    "Yearly": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل سنة"
          }
        }
      }
    },
    "Yes": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيه"
          }
        }
      }
    },
    "You can spend AED %lld today, %lld days to payday.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدر تصرف %1$lld درهم اليوم، والأيام الباقية على الراتب: %2$lld."
          }
        }
      }
    },
    "You pay for %@ · keep one, save %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشترك في %1$@ · خلّ واحد ووفّر %2$@"
          }
        }
      }
    },
    "You spend %@ a month on %@; around %@ is typical. Trimming a quarter of the gap saves %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصرف %1$@ بالشهر على %2$@، والمعتاد تقريبًا %3$@. لو خففت ربع الفرق توفّر %4$@."
          }
        }
      }
    },
    "You spend about %@ a day.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصرف تقريباً %@ باليوم."
          }
        }
      }
    },
    "You'll reach it in %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بتوصله في %@"
          }
        }
      }
    },
    "You're doing great": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ممتاز، كمّل كذا"
          }
        }
      }
    },
    "You've got room": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندك مجال"
          }
        }
      }
    },
    "You've had the pot early: %@ still to pay in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استلمت الجمعية بدري: باقي عليك تدفع %@."
          }
        }
      }
    },
    "You've had your turn · %lld shares left": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخذت دورك · باقي عليك %#@n@"
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg أسهم"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg سهم"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "سهم واحد"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg سهم"
                    }
                  },
                  "two": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "سهمين"
                    }
                  },
                  "zero": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Your bank already texts you every purchase": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بنكك يرسل لك رسالة مع كل عملية"
          }
        }
      }
    },
    "Your first transaction arrived": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت أول عملية"
          }
        }
      }
    },
    "Your messages and transactions stay on this iPhone. Khurda has no server and never asks for bank logins.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسائلك وعملياتك تبقى على هذا الآيفون. خردة ما عنده خادم وما يطلب أبداً بيانات دخول البنك."
          }
        }
      }
    },
    "Your money": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فلوسك"
          }
        }
      }
    },
    "Your month": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شهرك"
          }
        }
      }
    },
    "Your pot": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جمعيتك"
          }
        }
      }
    },
    "Your pot is your own money coming back (or paid in advance), so it doesn't go into today's amount.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جمعيتك هي فلوسك ترجع لك (أو مقدّمة لك)، فما تدخل في مصروف اليوم."
          }
        }
      }
    },
    "Your salary": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راتبك"
          }
        }
      }
    },
    "Your salary's day is your payday: each pay cycle runs from one salary to the next.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوم راتبك هو بداية دورتك: كل دورة راتب تمشي من راتب للراتب اللي بعده."
          }
        }
      }
    },
    "Your turn": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورك"
          }
        }
      }
    },
    "Your turn in %lld months · %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورك بعد %#@n@ · %2$@"
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg أشهر"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg شهر"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "شهر"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg شهر"
                    }
                  },
                  "two": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "شهرين"
                    }
                  },
                  "zero": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg شهر"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Your turn this month: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورك هالشهر: %@"
          }
        }
      }
    },
    "Your turn: %lld": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورك: %lld"
          }
        }
      }
    },
    "Your turn: %lld · %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورك: %1$lld · %2$@"
          }
        }
      }
    },
    "Your usual spending and daily target now include this history. See them in Plan and Insights.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصروفك المعتاد وهدفك اليومي صاروا يحسبون هالحركات القديمة. شوفهم في الخطة ونظرة."
          }
        }
      }
    },
    "about": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقريبًا"
          }
        }
      }
    },
    "khurda.csv": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "khurda.csv"
          }
        }
      }
    },
    "there by %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توصل له في %@"
          }
        }
      }
    }
  },
