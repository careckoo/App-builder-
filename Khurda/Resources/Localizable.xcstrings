                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg أشهر"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg شهر"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "شهر"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg شهر"
                    }
                  },
                  "two": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "شهرين"
                    }
                  },
                  "zero": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg شهر"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Your turn this month: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورك هالشهر: %@"
          }
        }
      }
    },
    "Your turn: %lld": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورك: %lld"
          }
        }
      }
    },
    "Your turn: %lld · %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورك: %1$lld · %2$@"
          }
        }
      }
    },
